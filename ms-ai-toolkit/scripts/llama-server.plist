<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the Gemma llama-server warm so gemma-run.sh never reloads the 7.5GB model.
     Install (once, per machine):
       ln -sf "$CLAUDE_PLUGIN_DIR"/scripts/llama-server.plist ~/Library/LaunchAgents/com.ms-ai-toolkit.llama-server.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ms-ai-toolkit.llama-server.plist
     Stop / uninstall:
       launchctl bootout gui/$(id -u)/com.ms-ai-toolkit.llama-server
     Costs ~8GB resident RAM for an always-warm model; bootout it if you need that back.
     Model is resolved by -hf, so llama.cpp downloads it on first run (brew install llama.cpp). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ms-ai-toolkit.llama-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/llama-server</string>
    <string>-hf</string><string>ggml-org/gemma-4-E4B-it-GGUF</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8080</string>
    <string>-ngl</string><string>99</string>
    <string>-c</string><string>8192</string>
    <string>--flash-attn</string><string>on</string>
    <string>--no-ui</string>
    <string>-t</string><string>8</string>
    <string>--chat-template-kwargs</string><string>{"enable_thinking":false}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Interactive keeps macOS from App-Nap-throttling generation latency -->
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/tmp/llama-server.log</string>
  <key>StandardErrorPath</key><string>/tmp/llama-server.log</string>
</dict>
</plist>
